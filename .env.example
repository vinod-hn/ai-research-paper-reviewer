# ============================================================
# Environment Configuration for AI Research Paper Reviewer
# ============================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env file to version control!

# Semantic Scholar API Key (Recommended for higher rate limits)
# Get your API key from: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# OpenAI API Key (Required for AI-powered paper analysis, draft generation, and critique)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Optional OpenAI model setting (defaults to gpt-4o-mini if not specified)
OPENAI_MODEL=gpt-4o-mini

# Semantic Scholar Search Configuration
SEMANTIC_SCHOLAR_TIMEOUT=15
SEMANTIC_SCHOLAR_MAX_RETRIES=3
USE_CACHED_METADATA_ON_FAILURE=1

# PDF Download Configuration
PDF_DOWNLOAD_TIMEOUT=25
PDF_DOWNLOAD_MAX_RETRIES=3
PDF_RETRY_ONLY_ON_RETRYABLE=1

# Text Extraction Configuration
USE_PYMUPDF_LAYOUT=false

# Optional Proxy settings (if behind corporate firewall)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
