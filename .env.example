# ============================================================
# Environment Configuration for AI Paper Review System
# ============================================================
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env file to version control!


SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

OpenAI API Key (Required for Milestones 3-5: text analysis and generation)
Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# Optional: Proxy settings (if behind corporate firewall)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# Optional: Download settings
# MAX_DOWNLOAD_RETRIES=3
# DOWNLOAD_TIMEOUT=30
